# Salin file ini jadi ".env" lalu isi nilainya sebelum menjalankan server.

# Wajib — kunci rahasia untuk menandatangani token login admin.
# Generate: openssl rand -hex 32
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-minimal-32-karakter

# Port server (opsional, default 3000)
PORT=3000

# CORS origin untuk production (ganti dengan domain kamu saat deploy)
# Contoh: https://nokayune.com
CORS_ORIGIN=*

# Tidak perlu isi apa pun di sini untuk pembayaran — QRIS diatur langsung dari dashboard admin
# (menu Pengaturan → Pembayaran QRIS), bukan dari file .env ini.
